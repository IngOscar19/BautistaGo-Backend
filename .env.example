# ─── Servidor ────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de datos (PostgreSQL en Docker) ────────
DATABASE_URL="postgresql://bautista_user:password@localhost:5432/bautistago_db?schema=public"

# ─── JWT ─────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_256bits_carnitas_bautista
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh_jwt_key_distinta_bautistago
JWT_REFRESH_EXPIRES_IN=7d

# ─── Firebase Admin SDK (Opcional - Notificaciones Push)
FIREBASE_PROJECT_ID=bautistago-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bautistago-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── CORS ────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bautistago.app

# ─── Rate limiting ───────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
