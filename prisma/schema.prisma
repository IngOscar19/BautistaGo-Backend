generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  KITCHEN_OPERATOR
  DELIVERY_DRIVER
  ADMIN

  @@map("user_role")
}

enum OrderStatus {
  PENDING_KITCHEN
  IN_PREPARATION
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum OrderType {
  COUNTER
  DINE_IN
  DELIVERY

  @@map("order_type")
}

enum PricingType {
  BY_WEIGHT_KG
  BY_WEIGHT_G
  BY_PIECE

  @@map("pricing_type")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED

  @@map("payment_status")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash")
  role         UserRole
  phone        String?   @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  fcmToken     String?   @map("fcm_token")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  orders         Order[]          @relation("CustomerOrders")
  deliveryDriver DeliveryDriver?
  statusLogs     OrderStatusLog[]
  refreshTokens  RefreshToken[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(150)
  description String?
  pricingType PricingType @map("pricing_type")
  basePrice   Decimal     @map("base_price") @db.Decimal(10, 2)
  isAvailable Boolean     @default(true) @map("is_available")
  imageUrl    String?     @map("image_url")
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  orderNumber      String      @unique @map("order_number") @db.VarChar(20)
  customerId       String?     @map("customer_id") @db.Uuid
  driverId         String?     @map("driver_id") @db.Uuid
  orderType        OrderType   @map("order_type")
  status           OrderStatus @default(PENDING_KITCHEN)
  subtotal         Decimal     @db.Decimal(12, 2)
  deliveryFee      Decimal     @default(0) @map("delivery_fee") @db.Decimal(8, 2)
  total            Decimal     @db.Decimal(12, 2)
  deliveryAddress  String?     @map("delivery_address")
  deliveryLat      Decimal?    @map("delivery_lat") @db.Decimal(9, 6)
  deliveryLng      Decimal?    @map("delivery_lng") @db.Decimal(9, 6)
  notes            String?
  estimatedReadyAt DateTime?   @map("estimated_ready_at") @db.Timestamptz()
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  customer               User?            @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  driver                 DeliveryDriver?  @relation("DriverOrders", fields: [driverId], references: [userId], onDelete: SetNull)
  items                  OrderItem[]
  payment                Payment?
  statusLogs             OrderStatusLog[]
  currentDriversAssigned DeliveryDriver[] @relation("CurrentOrder")

  @@index([status], map: "idx_orders_status")
  @@index([customerId], map: "idx_orders_customer")
  @@index([createdAt(sort: Desc)], map: "idx_orders_created")
  @@map("orders")
}

model DeliveryDriver {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  vehiclePlate   String?  @map("vehicle_plate") @db.VarChar(15)
  isAvailable    Boolean  @default(true) @map("is_available")
  currentOrderId String?  @map("current_order_id") @db.Uuid

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentOrder Order?  @relation("CurrentOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)
  driverOrders Order[] @relation("DriverOrders")

  @@map("delivery_drivers")
}

model OrderItem {
  id                  String      @id @default(uuid()) @db.Uuid
  orderId             String      @map("order_id") @db.Uuid
  productId           String      @map("product_id") @db.Uuid
  quantity            Decimal     @db.Decimal(8, 3)
  pricingTypeSnapshot PricingType @map("pricing_type_snapshot")
  unitPriceSnapshot   Decimal     @map("unit_price_snapshot") @db.Decimal(10, 2)
  subtotal            Decimal     @db.Decimal(10, 2)
  notes               String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  amountTendered Decimal?      @map("amount_tendered") @db.Decimal(12, 2)
  changeDue      Decimal?      @map("change_due") @db.Decimal(10, 2)
  referenceCode  String?       @map("reference_code") @db.VarChar(100)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model OrderStatusLog {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by") @db.Uuid
  notes      String?
  changedAt  DateTime     @default(now()) @map("changed_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId], map: "idx_status_log_order")
  @@index([changedAt(sort: Desc)], map: "idx_status_log_time")
  @@map("order_status_log")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}
